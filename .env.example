# Public URL of the Apache PHP API. Keep MySQL credentials in Apache's environment.
VITE_MYSQL_API_URL=http://localhost/naturaL-disaster-backend/api.php
MYSQL_API_URL=http://localhost/naturaL-disaster-backend/api.php

# Server-only Groq credential used by the SentinelCM disaster assistant.
GROQ_API_KEY=gsk_your_key_here